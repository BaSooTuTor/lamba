{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lamba",
  "account_id": "81bd516e97a4ce42357222f52eea7026",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Lets the worker call itself (used by OpenNext for caching/revalidation).
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lamba"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    // Paymob redirects to $APP_URL/billing/result.
    "APP_URL": "https://lamba.abdulbasitsharaf.workers.dev"
  }
  // NEXT_PUBLIC_* values are baked in at build time from .env.local (public only).
  // Server secrets (not committed): `npx wrangler secret bulk .env.cloudflare`
  // SUPABASE_SECRET_KEY, PAYMOB_SECRET_KEY, PAYMOB_PUBLIC_KEY,
  // PAYMOB_CARD_INTEGRATION_ID, PAYMOB_HMAC_SECRET, PAYMOB_WEBHOOK_URL
}
