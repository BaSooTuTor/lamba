# Never commit real values. Three files, split so secrets stay out of the build:

# --- .env.local: public values only (Next.js/OpenNext bake this into the build) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- .env.secrets: dev-only server values, loaded by `npm run dev` ---
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
SUPABASE_SECRET_KEY=
# Paymob webhook (Supabase Edge Function). Must be publicly reachable for Paymob.
PAYMOB_WEBHOOK_URL=
# Public base URL of the app (Paymob redirects to $APP_URL/billing/result).
APP_URL=http://localhost:3000
# Set to true only in dev/demo to enable /mock-payment and /api/mock-payment.
ENABLE_MOCK_PAYMENT=
# Used only by the Supabase CLI (link / db push). Never expose to the app.
SUPABASE_DB_PASSWORD=

# --- .env.cloudflare: prod server secrets, `npx wrangler secret bulk .env.cloudflare` ---
# SUPABASE_SECRET_KEY, PAYMOB_SECRET_KEY, PAYMOB_PUBLIC_KEY,
# PAYMOB_CARD_INTEGRATION_ID, PAYMOB_HMAC_SECRET, PAYMOB_WEBHOOK_URL
# (APP_URL is set in wrangler.jsonc vars; never set ENABLE_MOCK_PAYMENT in prod.)
