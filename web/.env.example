# Copy to .env.local and fill in. Never commit real values.
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Paymob webhook (Supabase Edge Function). Must be publicly reachable for Paymob.
PAYMOB_WEBHOOK_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL of the app (Paymob redirects to $APP_URL/billing/result).
APP_URL=

# Set to true only in dev/demo to enable /mock-payment and /api/mock-payment.
ENABLE_MOCK_PAYMENT=
